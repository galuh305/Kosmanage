generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id                  Int       @id @default(autoincrement())
  name                String
  email               String    @unique
  password            String
  phone               String?
  role                Role      @default(TENANT)
  isActive            Boolean   @default(true)
  mustChangePassword  Boolean   @default(false)
  activationTokenHash String?   @unique
  activationExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  bookings Booking[]
  leases   Lease[]
}

enum Role {
  OWNER
  TENANT
}

model RoomType {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?  @db.Text
  basePrice   Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms Room[]
}

model Room {
  id          Int        @id @default(autoincrement())
  roomNumber  String     @unique
  name        String
  description String?    @db.Text
  price       Decimal?   @db.Decimal(12, 2)
  imageUrl    String?
  status      RoomStatus @default(AVAILABLE)
  roomTypeId  Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  roomType            RoomType             @relation(fields: [roomTypeId], references: [id])
  facilities          RoomFacility[]
  bookings            Booking[]
  leases              Lease[]
  maintenanceRequests MaintenanceRequest[]
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
}

model Facility {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  rooms RoomFacility[]
}

model RoomFacility {
  roomId     Int
  facilityId Int

  room     Room     @relation(fields: [roomId], references: [id])
  facility Facility @relation(fields: [facilityId], references: [id])

  @@id([roomId, facilityId])
}

model Booking {
  id         Int           @id @default(autoincrement())
  userId     Int?
  roomId     Int
  guestName  String
  guestEmail String
  guestPhone String
  startDate  DateTime
  endDate    DateTime?
  message    String?       @db.Text
  status     BookingStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user  User?  @relation(fields: [userId], references: [id])
  room  Room   @relation(fields: [roomId], references: [id])
  lease Lease?
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Lease {
  id           Int         @id @default(autoincrement())
  bookingId    Int         @unique
  userId       Int
  roomId       Int
  startDate    DateTime
  endDate      DateTime
  monthlyPrice Decimal     @db.Decimal(12, 2)
  status       LeaseStatus @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  booking             Booking              @relation(fields: [bookingId], references: [id])
  user                User                 @relation(fields: [userId], references: [id])
  room                Room                 @relation(fields: [roomId], references: [id])
  invoices            Invoice[]
  maintenanceRequests MaintenanceRequest[]

  extensions   LeaseExtension[]
  terminations LeaseTermination[]
}

enum LeaseStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  TERMINATED
}

model LeaseExtension {
  id        Int  @id @default(autoincrement())
  leaseId   Int
  invoiceId Int? @unique

  requestedMonths  Int
  requestedEndDate DateTime
  approvedEndDate  DateTime?

  tenantNote String? @db.Text
  ownerNote  String? @db.Text

  status LeaseExtensionStatus @default(PENDING)

  approvedAt  DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lease   Lease    @relation(fields: [leaseId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])
}

model LeaseTermination {
  id      Int @id @default(autoincrement())
  leaseId Int

  requestedMoveOutDate DateTime
  actualMoveOutDate    DateTime?

  reason     String  @db.Text
  tenantNote String? @db.Text
  ownerNote  String? @db.Text

  refundAmount    Decimal? @db.Decimal(12, 2)
  deductionAmount Decimal? @db.Decimal(12, 2)

  status LeaseTerminationStatus @default(PENDING)

  approvedAt  DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lease Lease @relation(fields: [leaseId], references: [id])
}

enum LeaseTerminationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum LeaseExtensionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

model Invoice {
  id            Int           @id @default(autoincrement())
  leaseId       Int
  invoiceNumber String        @unique
  amount        Decimal       @db.Decimal(12, 2)
  dueDate       DateTime
  paidAt        DateTime?
  status        InvoiceStatus @default(UNPAID)
  description   String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  lease          Lease           @relation(fields: [leaseId], references: [id])
  payments       Payment[]
  leaseExtension LeaseExtension?
}

enum InvoiceStatus {
  UNPAID
  PAID
  OVERDUE
  CANCELLED
}

model Payment {
  id                Int       @id @default(autoincrement())
  invoiceId         Int
  orderId           String?   @unique
  amount            Decimal   @db.Decimal(12, 2)
  paymentMethod     String    @default("BANK_TRANSFER")
  transactionStatus String    @default("PENDING_VERIFICATION")
  proofUrl          String?
  ownerNote         String?   @db.Text
  paidAt            DateTime?
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  invoice       Invoice               @relation(fields: [invoiceId], references: [id])
  notifications PaymentNotification[]
}

model PaymentNotification {
  id                Int      @id @default(autoincrement())
  paymentId         Int
  transactionStatus String
  fraudStatus       String?
  notificationData  Json
  createdAt         DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])
}

model MaintenanceRequest {
  id          Int               @id @default(autoincrement())
  leaseId     Int
  roomId      Int
  title       String
  description String            @db.Text
  photoUrl    String?
  status      MaintenanceStatus @default(PENDING)
  ownerNote   String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  lease Lease @relation(fields: [leaseId], references: [id])
  room  Room  @relation(fields: [roomId], references: [id])
}

enum MaintenanceStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}
